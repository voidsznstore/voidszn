# Copy to .env.local for local work. Set the same keys in Vercel for production.
# Never commit real values.

# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/voidszn"

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments (Stripe). Use sandbox keys everywhere except production.
# Secret key: sk_test_... in a sandbox. For live, use a restricted key (rk_live_...).
STRIPE_SECRET_KEY=""
# Publishable key: pk_test_... or pk_live_... Safe to expose; it ships to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint at /api/webhooks/stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# --- Added in later steps (leave blank until then) ---

# Fulfillment
FULFILLMENT_PROVIDER="MANUAL"
PRINTMOOD_API_KEY=""

# Email
RESEND_API_KEY=""
FROM_EMAIL="orders@voidszn.com"

# Image storage (custom domain, not the r2.dev URL)
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Admin sessions
AUTH_SECRET=""
