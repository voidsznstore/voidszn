# Copy to .env.local for local work. Set the same keys in Vercel for production.
# Never commit real values.

# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/voidszn"

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments (Square). The access token is the only value the store needs: it works
# out sandbox vs live, finds the location and registers its own webhook.
# Use the Sandbox access token until launch, then swap in the Production one.
SQUARE_ACCESS_TOKEN=""
# Optional overrides. Leave unset unless something needs forcing.
# SQUARE_ENVIRONMENT="sandbox"            # or "production"
# SQUARE_LOCATION_ID=""
# SQUARE_WEBHOOK_SIGNATURE_KEY=""

# Email (Resend). Order, shipping and refund emails and admin password reset.
# The domain of siteConfig.ordersEmail must be verified in Resend.
RESEND_API_KEY=""

# Optional. Cart reminders are sent by a timer that calls /api/cron/cart-reminders
# (see vercel.json). Set any long random value here and only Vercel's timer can call it.
CRON_SECRET=""

# Inbox in the admin. An "app password" made at myaccount.google.com/apppasswords for
# the Gmail address in siteConfig.inboxEmail. Not the account's real password.
GMAIL_APP_PASSWORD=""

# Card payouts to partners (Stripe Connect). Customers never pay through Stripe.
# A restricted key (rk_...) with write access to Connect, Transfers and Payouts and
# read access to Balance. Without it, payouts are sent by hand. See docs/card-payouts.md.
STRIPE_SECRET_KEY=
# Optional. The signing secret of a Stripe webhook pointed at /api/webhooks/stripe
# for payout.paid, payout.failed and payout.canceled on connected accounts.
STRIPE_WEBHOOK_SECRET=

# --- Added in later steps (leave blank until then) ---

# Fulfillment
FULFILLMENT_PROVIDER="MANUAL"
PRINTMOOD_API_KEY=""


# Image storage (custom domain, not the r2.dev URL)
R2_ENDPOINT=""
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
